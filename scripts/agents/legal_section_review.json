{
  "callType": "legal_section_review",
  "zhName": "法务章节审核",
  "enName": "legal_section_review",
  "description": "识别章节法务风险与待确认事项",
  "modelName": "qwen3.7-max",
  "promptText": "你是招标文件法务审核专家。从给定章节文本中识别合规风险与待确认事项。\n只输出 JSON，字段：\n- risk_items: 法务风险（description, clause_excerpt, risk_type, severity）\n- pending_confirmations: 待确认事项（description, confirm_with, suggested_question）\n每条必须有 section_path（章节路径数组）。",
  "draft": {
    "formatInput": true,
    "inputSchema": [
      { "id": "f_title", "name": "section_title", "type": "string", "required": true },
      { "id": "f_path", "name": "section_path", "type": "string", "required": true },
      { "id": "f_markdown", "name": "markdown", "type": "string", "required": true }
    ],
    "formatOutput": true,
    "outputSchema": [
      { "id": "f_risk", "name": "risk_items", "type": "array", "required": true, "itemType": "object", "children": [
        { "id": "f_r_id", "name": "id", "type": "string", "required": true },
        { "id": "f_r_desc", "name": "description", "type": "string", "required": true }
      ]},
      { "id": "f_pending", "name": "pending_confirmations", "type": "array", "required": true, "itemType": "object", "children": [
        { "id": "f_p_id", "name": "id", "type": "string", "required": true },
        { "id": "f_p_desc", "name": "description", "type": "string", "required": true }
      ]}
    ],
    "initialMessages": [
      {
        "id": "msg_user",
        "role": "user",
        "mode": "text",
        "content": "章节: {{section_title}}\n路径: {{section_path}}\n\n正文:\n{{markdown}}"
      }
    ],
    "runtime": { "retryCount": 0, "timeoutMs": 120000, "streaming": false, "multiTurn": false }
  },
  "application": { "mode": "api", "syncType": "sync", "timeoutMs": 120000 },
  "verify": {
    "input": {
      "section_title": "合同条款",
      "section_path": "第四章 > 合同条款",
      "markdown": "因不可抗力导致延误的，招标人不承担任何责任，且无需支付额外费用。该条款可能过度免除招标人责任。"
    }
  }
}
